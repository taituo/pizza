# Copy to .env for local development. Never commit real keys.

DATABASE_URL=postgres://pizza:pizza@localhost:5432/pizza
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud: set the address, namespace and API key.
TEMPORAL_API_KEY=

# Token for the staff views (kitchen, driver, overview). Required in production.
STAFF_TOKEN=dev-staff-token

# Shared secret between the API and the agent workers. Required in production.
AGENT_TOKEN=dev-agent-token
# Ordering agent. Without AGENT_MODEL the scripted harness answers (no model, no key needed).
# With a model, Deep Agents answers: e.g. anthropic:claude-sonnet-5-5 (+ ANTHROPIC_API_KEY) or openai:<model> (+ OPENAI_API_KEY).
AGENT_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The address customers use to reach the shop (Stripe return links).
PUBLIC_URL=http://localhost:5173

# sim = simulated payment, stripe = Stripe Checkout (test or live keys)
PAYMENT_PROVIDER=sim
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 0..1: share of random failures in the simulated payment provider (demo of Temporal retries)
SIM_PAYMENT_FAIL_RATE=0

RESTAURANT_NAME=Golden Sample Pizzeria
RESTAURANT_LAT=60.1699
RESTAURANT_LNG=24.9384
DELIVERY_RADIUS_KM=8
DELIVERY_FEE_CENTS=390
