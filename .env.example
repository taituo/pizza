# Kopioi tiedostoksi .env paikallista kehitystä varten. Älä vie oikeita avaimia versionhallintaan.

DATABASE_URL=postgres://pizza:pizza@localhost:5432/pizza
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud: aseta osoite, namespace ja API-avain.
TEMPORAL_API_KEY=

# Henkilökunnan näkymien (keittiö, kuljettaja, tilannekuva) tunniste. Pakollinen tuotannossa.
STAFF_TOKEN=dev-staff-token

# Osoite, josta asiakkaat käyttävät kauppaa (Stripen paluulinkit).
PUBLIC_URL=http://localhost:5173

# sim = simuloitu maksu, stripe = Stripe Checkout (testi- tai live-avaimilla)
PAYMENT_PROVIDER=sim
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 0..1: simuloidun maksupalvelun satunnaisten häiriöiden osuus (Temporalin uudelleenyritysten demo)
SIM_PAYMENT_FAIL_RATE=0

RESTAURANT_NAME=Pizzeria Kultainen Näyte
RESTAURANT_LAT=60.1699
RESTAURANT_LNG=24.9384
DELIVERY_RADIUS_KM=8
DELIVERY_FEE_CENTS=390
